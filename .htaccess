# ============================================
# PyroprintDamir - .htaccess
# ============================================

RewriteEngine On

# 1) Forsiraj HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [L,R=301]

# 2) Forsiraj www (ukloni ako koristiš non-www kao kanonski)
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.%{HTTP_HOST}/$1 [L,R=301]

# 3a) Stari blog URL-ovi (?post=slug) -> novi čisti URL-ovi (/blog/slug)
RewriteCond %{QUERY_STRING} ^post=([a-z0-9\-]+)$
RewriteRule ^blog/?(index\.html)?$ /blog/%1? [R=301,L]

# 3) Ukloni .html nastavak iz URL-a (npr. /galerija.html -> /galerija)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 4) Interno preusmjeri čisti URL na stvarnu .html datoteku
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html [L]

# 5) Ukloni trailing slash (osim za direktorije poput /blog/)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# 6) Custom 404 stranica (opcionalno - napravi 404.html ako želiš)
# ErrorDocument 404 /404.html

# ============================================
# Sigurnost i performanse
# ============================================

# Onemogući listanje direktorija
Options -Indexes

# Kompresija (gzip)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

# Cache statičkih resursa
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
